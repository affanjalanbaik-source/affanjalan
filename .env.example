# PayPal Sandbox credentials: create them in the PayPal Developer Dashboard.
# Never commit real values or put a client secret in browser code.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
# Required for verifying webhook signatures. Leave blank until a webhook is registered.
PAYPAL_WEBHOOK_ID=
# Set this to the exact public HTTPS origin of the deployed app.
PUBLIC_ORIGIN=http://localhost:3000
# SQLite database path and private audio delivery root (outside public web root).
DATABASE_PATH=./data/orders.sqlite
PRIVATE_BEAT_DIR=./private-beats
# Public previews are small, approved clips. Keep master files in PRIVATE_BEAT_DIR.
PREVIEW_DIR=./previews
# Set a long, unique random session secret for production.
SESSION_SECRET=replace_with_a_long_random_secret
# Required only for password-protected owner dashboard access.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace_with_a_unique_strong_password
PORT=3000
